# Run `dotnet ClangSharpPInvokeGenerator @path\to\this_file` at the project root

--config
codegen=preview
# exclude-using-statics-for-enums
# exclude-enum-operators
file=multi
types=unix

--generate
helper-types
macro-bindings
native-bitfield-attribute
# generate-generic-pointer-wrapper
# generate-doc-includes
# generate-tests-xunit

--library-path
git2

--language
c

# --with-using
# git_credential_username=System.Runtime.CompilerServices

--with-type
GIT_STATUS_OPT_DEFAULTS=git_status_opt_t

--traverse
thirdparty/libgit2/include/git2/global.h
thirdparty/libgit2/include/git2/common.h
thirdparty/libgit2/include/git2/types.h
thirdparty/libgit2/include/git2/oid.h
thirdparty/libgit2/include/git2/buffer.h
thirdparty/libgit2/include/git2/commit.h
thirdparty/libgit2/include/git2/repository.h
thirdparty/libgit2/include/git2/version.h
thirdparty/libgit2/include/git2/refs.h
thirdparty/libgit2/include/git2/strarray.h
thirdparty/libgit2/include/git2/config.h
thirdparty/libgit2/include/git2/errors.h
thirdparty/libgit2/include/git2/revwalk.h
thirdparty/libgit2/include/git2/odb.h
thirdparty/libgit2/include/git2/odb_backend.h
thirdparty/libgit2/include/git2/tree.h
thirdparty/libgit2/include/git2/blob.h
thirdparty/libgit2/include/git2/tag.h
thirdparty/libgit2/include/git2/object.h
thirdparty/libgit2/include/git2/refspec.h
thirdparty/libgit2/include/git2/trace.h
thirdparty/libgit2/include/git2/net.h
thirdparty/libgit2/include/git2/pathspec.h
thirdparty/libgit2/include/git2/diff.h
thirdparty/libgit2/include/git2/signature.h
thirdparty/libgit2/include/git2/patch.h
thirdparty/libgit2/include/git2/apply.h
thirdparty/libgit2/include/git2/index.h
thirdparty/libgit2/include/git2/remote.h
thirdparty/libgit2/include/git2/proxy.h
thirdparty/libgit2/include/git2/cert.h
thirdparty/libgit2/include/git2/indexer.h
thirdparty/libgit2/include/git2/credential.h
thirdparty/libgit2/include/git2/attr.h
thirdparty/libgit2/include/git2/status.h
thirdparty/libgit2/include/git2/branch.h
thirdparty/libgit2/include/git2/reset.h
thirdparty/libgit2/include/git2/checkout.h
thirdparty/libgit2/include/git2/merge.h
thirdparty/libgit2/include/git2/oidarray.h
thirdparty/libgit2/include/git2/sys/credential.h
thirdparty/libgit2/include/git2/sys/config.h

--file
Lg2/scripts/ClangSharp/git2headers.h


# --file-directory

--include-directory
thirdparty/libgit2/include

--additional
-isysroot
/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk


# --std
# c17

--exclude
GIT_OID_DEFAULT
# C# does not support octal literals
git_filemode_t
# unused for now
git_odb_writepack
git_odb_write_pack

# use Path.PathSeparator from .NET instead
GIT_PATH_LIST_SEPARATOR

--method-class-name
LibGit2Exports

--namespace
Lg2.Native

--output
Lg2/Native/

# --test-output
# Lg2/Native.Tests/

# end